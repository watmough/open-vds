// Static factory methods
// =============================================================================

OpenDataStore* OpenDataStore::Open(const char* fileName) {
    auto store = new OpenDataStoreImpl();
    store->m_fileName = fileName;

    store->m_file = fopen(fileName, "rb");
    if (!store->m_file) {
        store->m_errorMessage = "Failed to open file";
        store->m_isOpen = false;
        return store;
    }

    store->m_readOnly = true;
    store->m_fileSize = store->getFileSize();

    // Read header
    if (!store->readAt(0, &store->m_header, sizeof(store->m_header))) {
        store->m_errorMessage = "Failed to read header";
        store->m_isOpen = false;
        return store;
    }

    // Verify magic
    if (memcmp(store->m_header.m_magic, MAGIC, 12) != 0) {
        store->m_errorMessage = "Invalid file magic";
        store->m_isOpen = false;
        return store;
    }

    // Read file table
    if (store->m_header.m_fileTableCount > 0 && store->m_header.m_fileTableOffset > 0) {
        int tableSize = store->m_header.m_fileTableCount * store->fileTableEntrySize();
        store->m_fileTableData.resize(tableSize);
        if (!store->readAt(store->m_header.m_fileTableOffset,
                          store->m_fileTableData.data(), tableSize)) {
            store->m_errorMessage = "Failed to read file table";
            store->m_isOpen = false;
            return store;
        }
        store->parseFileTable();

        // Track the committed file table for proper freeing on updates
        store->m_committedFileTableOffset = store->m_header.m_fileTableOffset;
        store->m_committedFileTableSize = tableSize;
    }

    store->m_isOpen = true;
    return store;
}

OpenDataStore* OpenDataStore::CreateNew(const char* fileName, bool overwriteExisting) {
    auto store = new OpenDataStoreImpl();
    store->m_fileName = fileName;

    const char* mode = overwriteExisting ? "w+b" : "w+bx";
    store->m_file = fopen(fileName, mode);
    if (!store->m_file && !overwriteExisting) {
        // Try with overwrite if exclusive create failed
        store->m_file = fopen(fileName, "w+b");
    }

    if (!store->m_file) {
        store->m_errorMessage = "Failed to create file";
        store->m_isOpen = false;
        return store;
    }

    store->m_readOnly = false;
    store->m_isOpen = true;

    // Initialize header
    memcpy(store->m_header.m_magic, MAGIC, 12);
    store->m_header.m_version = VERSION;
    store->m_header.m_fileTableOffset = 0;
    store->m_header.m_fileTableCount = 0;
    store->m_header.m_fileNameLength = DEFAULT_FILENAME_LENGTH;

    // Write header
    store->m_fileSize = sizeof(ODSDataStoreHeader);
    store->writeAt(0, &store->m_header, sizeof(store->m_header));

    return store;
}

void OpenDataStore::Close(OpenDataStore* dataStore) {
    delete dataStore;
}

void OpenDataStore::ReleaseBuffer(Buffer* buffer) {
    delete buffer;
}
